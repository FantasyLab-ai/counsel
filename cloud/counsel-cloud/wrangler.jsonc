{
  // counsel-cloud — hosted sync backend (tokens encrypted, data pass-through).
  // Deploy: npx wrangler deploy
  // Secrets: npx wrangler secret put ENC_KEY   (64 hex chars = 32-byte AES key)
  //   Rotating ENC_KEY invalidates every stored provider token (users just
  //   reconnect) — accounts themselves survive.
  "name": "counsel-cloud",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "kv_namespaces": [
    { "binding": "ACCOUNTS", "id": "5e7637bd075b4553ab5efe4881d3120b" }
  ],
  // Plaid: client_id is semi-public config; the SECRET is a wrangler secret
  // (npx wrangler secret put PLAID_SECRET). Flip PLAID_ENV to "production"
  // (and set the production secret) once Plaid approves production access.
  "vars": {
    "PLAID_CLIENT_ID": "6a5a5485b55542000ca154b5",
    "PLAID_ENV": "sandbox",
    "SQUARE_CLIENT_ID": "sq0idp-t2S6tWCrHRvCMSGwdTG3DA",
    "SQUARE_OAUTH_ENV": "production",
    "ETSY_CLIENT_ID": "9jrjuecsq3mxb5jusixtbcqk",
    "SHOPIFY_CLIENT_ID": "a2448137f1eaae2812da54bebd40540f",
    // LIVE Stripe Connect client id (platform review cleared 2026-08-18).
    // Pairs with the live STRIPE_SECRET_KEY secret for token exchange.
    "STRIPE_CLIENT_ID": "ca_V5foouysKSN8v0Yza4bMisFCSKlLqv7M"
  },
  // demo pulse: every 30 min, seed 1–3 fake sales into pulse-enabled accounts
  // (test/sandbox credentials only — live keys are never written to)
  "triggers": { "crons": ["*/30 * * * *"] },
  // rate limits (per colo; keyed by IP or account in code). Three tiers:
  //   STRICT — account mint, telemetry, backfill/pulse, signed execution
  //   SYNC   — /v1/sync fan-out to provider APIs (the expensive call)
  //   NORM   — everything else
  // Code fails OPEN if a binding is missing, so config drift can't kill the API.
  "unsafe": {
    "bindings": [
      { "name": "RL_STRICT", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
      { "name": "RL_SYNC", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 15, "period": 60 } },
      { "name": "RL_NORM", "type": "ratelimit", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
    ]
  }
}
